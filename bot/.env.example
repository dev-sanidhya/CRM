# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Claude auth for the Agent SDK (from `claude setup-token`), or ANTHROPIC_API_KEY
CLAUDE_CODE_OAUTH_TOKEN=
# Password of the read-only Postgres role crm_bot
BOT_DB_PASSWORD=
# One private code per founder; each sends "/start <their code>" once. Format Name:CODE,Name:CODE
BOT_FOUNDERS=Sanidhya:SANIDHYA-XXXXXX,Atharva:ATHARVA-XXXXXX
# polling (always-on process) or webhook (hosts that sleep, e.g. Render free)
BOT_MODE=polling
# webhook mode only
BOT_WEBHOOK_SECRET=
PUBLIC_URL=
# optional
BOT_MODEL=claude-opus-5-5
BOT_SCHEDULER=0

# Voice notes: Whisper on Cloudflare Workers AI (free tier); Groq Whisper as an optional backup.
CF_ACCOUNT_ID=
CF_API_TOKEN=
GROQ_API_KEY=

# Google Calendar (agency account): OAuth client of type "Desktop app"; run scripts/google-auth.js once
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_ACCOUNT=aperturecmservices@gmail.com
# Founders invited to booked calls. Format Name:email,Name:email
CALENDAR_GUESTS=Sanidhya:you@example.com,Atharva:you@example.com
