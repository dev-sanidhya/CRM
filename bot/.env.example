# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Claude auth for the Agent SDK (from `claude setup-token`), or ANTHROPIC_API_KEY
CLAUDE_CODE_OAUTH_TOKEN=
# Password of the read-only Postgres role crm_bot
BOT_DB_PASSWORD=
# One private code per founder; each sends "/start <their code>" once. Format Name:CODE,Name:CODE
BOT_FOUNDERS=Sanidhya:SANIDHYA-XXXXXX,Atharva:ATHARVA-XXXXXX
# polling (always-on process) or webhook (hosts that sleep, e.g. Render free)
BOT_MODE=polling
# webhook mode only
BOT_WEBHOOK_SECRET=
PUBLIC_URL=
# optional
BOT_MODEL=claude-opus-5-5
BOT_SCHEDULER=0
